{
  "name": "tuniinvoice-pro",
  "version": "4.5.0",
  "description": "Tunisian Invoice Generator - Desktop Edition",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rm -rf dist",
    "build": "electron-builder",
    "build:win": "npm run clean && electron-builder --win",
    "build:mac": "npm run clean && electron-builder --mac",
    "build:linux": "npm run clean && electron-builder --linux",
    "build:all": "npm run clean && electron-builder --win --mac --linux",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js'"
  },
  "dependencies": {
    "archiver": "^6.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "electron-updater": "^6.1.7",
    "extract-zip": "^2.0.1",
    "leaflet": "^1.9.4",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3"
  },
  "build": {
    "appId": "com.tuniinvoice.pro",
    "publish": [
      {
        "provider": "github",
        "owner": "a32116150-ctrl",
        "repo": "tuninvoice"
      }
    ],
    "productName": "Factarlou",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "assets/iconblack2.png",
      "category": "public.app-category.finance",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Finance",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
